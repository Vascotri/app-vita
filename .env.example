# Real values are set per-environment in Vercel (Preview vs Production scopes) — NOT committed here.
# This file just documents the variables the app expects.
# Locally, copy to `.env.local` (gitignored) and fill in.

# Browser-exposed config must be prefixed NEXT_PUBLIC_
NEXT_PUBLIC_APP_NAME=Vita

# --- NextAuth ---
# The canonical URL of this deployment. Must match the origin the browser uses,
# or the OAuth callback fails. Set to the preview URL in the Preview scope.
NEXTAUTH_URL=https://app-vita.vercel.app
# SELF-GENERATED (not fetched from anywhere): `openssl rand -base64 32`
NEXTAUTH_SECRET=

# --- Google OAuth ---
# console.cloud.google.com -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs.
# The client needs this exact Authorised redirect URI:
#   https://app-vita.vercel.app/api/auth/callback/google
# and, for local dev:
#   http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Access control ---
# The ONLY address allowed to sign in. Comma-separated if a second person is
# ever added. Kept in the environment rather than in source because this repo is
# public — a hardcoded address is free food for scrapers.
# Fails CLOSED: unset means nobody gets in, including the owner.
VITA_ALLOWED_EMAIL=

# --- Supabase (server-only) ---
# supabase.com -> project -> Project Settings -> API.
# Paste either the bare origin or the REST endpoint; lib/supabase.ts normalises it.
SUPABASE_URL=
# The "service_role" / secret key from the same screen. NEVER expose to the browser —
# it bypasses row level security.
SUPABASE_SERVICE_ROLE_KEY=

# --- Claude (slice 2: photo -> calorie estimation) ---
# console.anthropic.com -> API keys. Pay-as-you-go, billed separately from any
# Claude subscription. The photo is never persisted — it goes to the API
# in-memory and is discarded after estimation.
# ANTHROPIC_API_KEY=
